# ─────────────────────────────────────────────────────────────────────────────
# Шаблон окружения. Скопируйте в .env и заполните значения:
#     cp env.example .env
#
# ВАЖНО: Settings (app/core/config.py) работает с extra="forbid". Любой ключ в
# .env, который не объявлен полем Settings, роняет приложение на импорте с
# ValidationError. Поэтому в .env можно писать только имена из этого файла —
# добавляя новую переменную, сначала объявите её в Settings.
# Правило проверяется тестом tests/test_env_example.py.
#
# Секреты не хранятся в репозитории. Локально — в .env (он в .gitignore),
# в проде — в дашборде Render (все секреты помечены sync: false в render.yaml).
#
# PORT и PYTHON_VERSION задаёт сам Render; локально они не нужны.
# ─────────────────────────────────────────────────────────────────────────────


# ═══ Учётные данные аукционов ════════════════════════════════════════════════
# Без них соответствующий сервис не аутентифицируется. Раньше эти значения
# отсутствовали и здесь, и в env.example — из-за чего локальный бэкенд молча
# отдавал 503 на /api/v1/lotte/* и /api/v1/kcar/*, а /api/v1/happycar/* — 500.
# Проверить, что именно не задано, не раскрывая значений:
#     GET /healthz/ready

# Lotte (основной путь /api/v1/lotte/*)
LOTTE_USERNAME=
LOTTE_PASSWORD=

# Второй аккаунт Lotte для /api/v2/lotte (enhanced).
# Если не задан — используется LOTTE_USERNAME / LOTTE_PASSWORD.
ENHANCED_LOTTE_USERNAME=
ENHANCED_LOTTE_PASSWORD=

# Autohub. AUTOHUB_JWT_TOKEN опционален: предзаполненный токен, чтобы
# пропустить логин.
AUTOHUB_USERNAME=
AUTOHUB_PASSWORD=
AUTOHUB_JWT_TOKEN=

# KCar
KCAR_USERNAME=
KCAR_PASSWORD=

# HappyCar. Требует ещё и AUCTION_PROXY_* (см. ниже) — login-gated сервис.
HAPPYCAR_USERNAME=
HAPPYCAR_PASSWORD=

# SK Auction
SK_AUCTION_USERNAME=
SK_AUCTION_PASSWORD=

# HeyDealer (общий дилерский аккаунт)
HEYDEALER_USERNAME=
HEYDEALER_PASSWORD=


# ═══ Egress / прокси ═════════════════════════════════════════════════════════

# Обязательный корейский прокси для Glovis (DB Auto).
# Без этих переменных Glovis работает в режиме fail-closed:
# каждый запрос возвращает 503 proxy_unavailable.
GLOVIS_PROXY_HOST=
GLOVIS_PROXY_USERNAME=
GLOVIS_PROXY_PASSWORD=
GLOVIS_PROXY_COUNTRY=
GLOVIS_PROXY_EGRESS_LABEL=

# Общий пул прокси. ОБЯЗАТЕЛЕН для HappyCar (login-gated, fails closed).
# ОПЦИОНАЛЕН для Encar: api.encar.com отвечает и не-корейским IP.
AUCTION_PROXY_HOST=
AUCTION_PROXY_USERNAME=
AUCTION_PROXY_PASSWORD=
AUCTION_PROXY_NAME=auction-proxy
AUCTION_PROXY_SUPPORTS_STICKY=false

# Выделенный корейский residential-прокси для HeyDealer (анти-throttle на
# единственный общий аккаунт/IP). Не задан — прямой egress.
HEYDEALER_PROXY_HOST=
HEYDEALER_PROXY_PORT=
HEYDEALER_PROXY_USERNAME=
HEYDEALER_PROXY_PASSWORD=

# JSON-список кандидатов egress для SSANCAR, например:
#     SSANCAR_PROXY_URLS=["http://user:pass@host:port"]
SSANCAR_PROXY_URLS=

# Переключатель egress для потребителей AsyncHttpClient (Encar catalog/nav/
# trucks/green). HappyCar этим флагом НЕ управляется — он берёт пул напрямую.
USE_PROXY=false


# ═══ Админ-доступ и безопасность ═════════════════════════════════════════════

# Заголовок X-Admin-Token для деструктивных и debug-эндпоинтов
# (cache clear, auth reset, /debug/*). Не задан — эти маршруты отдают 503.
ADMIN_API_TOKEN=

# Отдельный токен для POST /api/v1/internal/glovis/cache/clear
GLOVIS_CACHE_ADMIN_TOKEN=

# Список origin'ов через запятую, которым разрешено обращаться к API из браузера.
# Это браузерная половина деплоя фронтенда: когда список расходится с реальным
# доменом, каждый client-side fetch падает на preflight с 400 "Disallowed CORS
# origin", а сайт рендерится без данных — при этом /health отвечает 200 и curl
# работает, потому что CORS проверяет браузер, а не сервер.
CORS_ALLOWED_ORIGINS=https://www.nonstop-motors.com,https://nonstop-motors.com,https://nonstopautoapp.vercel.app,http://localhost:3000,http://127.0.0.1:3000

# Регулярное выражение для origin'ов, которые нельзя перечислить заранее:
# Vercel выдаёт новый хост на каждую ветку и каждый деплой.
# Starlette сопоставляет его через re.fullmatch() со ВСЕМ Origin целиком —
# ^ и $ не нужны и опасны ($ совпадает и перед завершающим переводом строки).
# Точки обязательно экранировать: не экранированная `.` совпадает с любым
# символом, поэтому `.vercel.app` примет и `xvercelxapp`.
# Slug команды обязателен: суффикс vercel.app общий, и шаблон без него совпадёт
# с чужим проектом, созданным в другой команде Vercel.
# Пусто -> preview-деплои не допускаются. Это безопасное значение по умолчанию.
# Пример: https://nonstopautoapp-[a-z0-9-]{1,48}-<team-slug>\.vercel\.app
CORS_ALLOWED_ORIGIN_REGEX=

# Публиковать /docs, /redoc и /openapi.json. По умолчанию выключено:
# они раскрывают весь список маршрутов, включая admin и debug.
ENABLE_API_DOCS=false

# Break-glass выключатель проверки сертификатов в requests. Держите true.
TLS_VERIFY=true

# Путь к CA-бандлу. Актуально локально: macOS framework Python идёт с пустым
# хранилищем доверия, из-за чего aiohttp не может проверить ни один сертификат.
SSL_CERT_FILE=
REQUESTS_CA_BUNDLE=


# ═══ Основные настройки приложения ═══════════════════════════════════════════
APP_NAME=AutoBaza Parser API
APP_VERSION=1.0.0
DEBUG=false

LOG_LEVEL=INFO
LOG_FILE=logs/app.log

REQUEST_TIMEOUT=30
MAX_RETRIES=3
RETRY_DELAY=1.0

USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36


# ═══ Базовые URL поставщиков ═════════════════════════════════════════════════
AUTOHUB_BASE_URL=https://www.autohubauction.co.kr
AUTOHUB_API_BASE_URL=https://api.ahsellcar.co.kr
AUTOHUB_SIGNIN_URL=https://api.ahsellcar.co.kr/auth/rest/api/v1/auth/signin
AUTOHUB_PRODUCT_ID=03db628d-2795-11ef-8342-0e80fc1e2c3f
LOTTE_BASE_URL=https://www.lotteautoauction.net


# ═══ Кэш ═════════════════════════════════════════════════════════════════════
CACHE_TTL=300
CACHE_TTL_STATIC=86400
CACHE_TTL_AUCTION_DATE=43200
CACHE_TTL_CAR_LIST=600
CACHE_TTL_CAR_DETAIL=3600
CACHE_TTL_FILTERS=7200
CACHE_TTL_EXCHANGE_RATE=900


# ═══ HeyDealer: хранилище маппингов и синхронизация ══════════════════════════
HEYDEALER_DATA_DIR=cache/heydealer
HEYDEALER_SYNC_REQUEST_DELAY_MS=1200
HEYDEALER_SYNC_INTERVAL_MINUTES=1440
HEYDEALER_SYNC_ON_STARTUP=false


# ═══ Autohub: режим недельного снапшота ══════════════════════════════════════
# Вторник 22:00 KST снимает каталог; среда отдаёт его, не трогая api.ahsellcar.
AUTOHUB_SNAPSHOT_ENABLED=false
AUTOHUB_SNAPSHOT_DAYS=2
AUTOHUB_SNAPSHOT_DB_PATH=/data/autohub_snapshot.db
AUTOHUB_SNAPSHOT_RETENTION=2
AUTOHUB_SNAPSHOT_TIMEZONE=Asia/Seoul
AUTOHUB_SNAPSHOT_MAX_AGE_DAYS=8
AUTOHUB_SNAPSHOT_ADMIN_TOKEN=
AUTOHUB_SNAPSHOT_ALERT_WEBHOOK=
